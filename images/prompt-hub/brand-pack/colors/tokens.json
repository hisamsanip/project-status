{
  "name": "Prompt Hub",
  "rule": "60% navy, 30% powder blue, 10% yellow",
  "brand": {
    "midnightNavy":   { "hex": "#131E3A", "rgb": [19, 30, 58],   "cmyk": [67, 48, 0, 77], "share": "60%" },
    "powderBlue":     { "hex": "#AFC6E9", "rgb": [175, 198, 233], "cmyk": [25, 15, 0, 9],  "share": "30%" },
    "sunflowerYellow":{ "hex": "#FFC20D", "rgb": [255, 194, 13],  "cmyk": [0, 24, 95, 0],  "share": "10%" }
  },
  "support": {
    "deepNavy": "#0D1530", "panelNavy": "#1B2A4D", "lineNavy": "#2A3C66",
    "ice": "#EAF1FB", "mist": "#EEF3FB", "mistLine": "#CFDBEE",
    "mutedOnDark": "#9DB1D1", "mutedOnLight": "#4F6288"
  },
  "contrast": { "navyOnYellow": 10.2, "whiteOnNavy": 16.5, "powderOnNavy": 9.5, "yellowOnWhite": 1.6 },
  "fonts": { "heading": "Inter ExtraBold", "body": "Inter", "label": "JetBrains Mono" }
}
